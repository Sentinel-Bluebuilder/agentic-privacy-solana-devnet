{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct/schema/connect.json",
  "title": "direct/connect.sh last line on success",
  "type": "object",
  "required": ["ok", "step", "next", "exitIp", "beforeIp", "nodeIp", "node", "session", "channel"],
  "properties": {
    "ok": {"const": true},
    "step": {"const": "connect"},
    "next": {"type": "string", "minLength": 1}, "alreadyConnected": {"const": true}, "note": {"type": "string", "minLength": 1}, "exitIp": {"type": "string"}, "beforeIp": {"type": "string"}, "nodeIp": {"type": "string"}, "node": {"type":"string","pattern":"^[1-9A-HJ-NP-Za-km-z]{32,44}$"}, "session": {"type": "string", "minLength": 1}, "channel": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
