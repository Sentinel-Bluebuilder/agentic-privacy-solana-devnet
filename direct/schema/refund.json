{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct/schema/refund.json",
  "title": "direct/refund.sh last line on success",
  "type": "object",
  "required": ["ok", "step", "next"],
  "properties": {
    "ok": {"const": true},
    "step": {"const": "refund"},
    "next": {"type": "string", "minLength": 1},
    "then": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "note": {"type": "string", "minLength": 1}, "channels": {"type": "array", "items": {"type": "object", "required": ["channel", "closeAfter"], "properties": {"channel": {"type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"}, "closeAfter": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"}}, "additionalProperties": false}}, "closeAfter": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"}, "userBalance": {"type": "integer", "minimum": 0}, "dvpn_base_units": {"type": "integer", "minimum": 0}, "lamports": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
